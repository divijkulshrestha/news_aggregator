# Environment Configuration
# Copy this file to .env and customize for your environment

# Database Configuration
DATABASE_URL=postgresql://news_user:news_password@db:5432/news_db

# For local development without Docker, use:
# DATABASE_URL=postgresql://news_user:news_password@localhost:5432/news_db

# For AWS RDS, use:
# DATABASE_URL=postgresql://username:password@your-rds-endpoint.region.rds.amazonaws.com:5432/news_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# ETL Schedule (when using AWS EventBridge or cron)
# Run every hour: 0 * * * *
# Run every 30 minutes: */30 * * * *
ETL_SCHEDULE="0 * * * *"

# Email Digest Configuration
# Leave SMTP_HOST empty to run send_digest.py in dry-run mode (prints instead of sending).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# For Gmail: use an App Password, not your regular password.
# https://myaccount.google.com/apppasswords
SMTP_USE_TLS=true

DIGEST_FROM_EMAIL=
DIGEST_TO_EMAIL=
# Categories to include (comma-separated). Leave empty for all categories.
DIGEST_CATEGORIES=
# Max articles per category in the digest
DIGEST_ARTICLES_PER_CATEGORY=5
