# Environment Configuration
# Copy this file to .env and customize for your environment

# Database Configuration
DATABASE_URL=postgresql://news_user:news_password@db:5432/news_db

# For local development without Docker, use:
# DATABASE_URL=postgresql://news_user:news_password@localhost:5432/news_db

# For AWS RDS, use:
# DATABASE_URL=postgresql://username:password@your-rds-endpoint.region.rds.amazonaws.com:5432/news_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# ETL Schedule (when using AWS EventBridge or cron)
# Run every hour: 0 * * * *
# Run every 30 minutes: */30 * * * *
ETL_SCHEDULE="0 * * * *"
