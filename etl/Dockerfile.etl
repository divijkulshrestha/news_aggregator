# etl/Dockerfile.etl
FROM jupyter/pyspark-notebook:latest 

# Switch to root to install packages and copy files to system directories
USER root

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app/

# Fix line endings for all shell scripts
RUN find /app -type f -name "*.sh" -exec sed -i 's/\r$//' {} \;

# Copy wait-for-it.sh to /usr/local/bin and set permissions
RUN cp /app/wait-for-it.sh /usr/local/bin/wait-for-it.sh && \
    chmod +x /usr/local/bin/wait-for-it.sh /app/run_etl_job.sh

# Switch back to the default jovyan user for security
USER $NB_UID